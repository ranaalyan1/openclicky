{
  "name": "openclicky-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "core",
    "cli",
    "apps/server",
    "apps/desktop",
    "sandbox"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -b",
    "test": "npm test -w core && npm test -w @openclicky/server",
    "test:core": "npm test -w core",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "start": "npm run start -w @openclicky/server",
    "chat": "npm run start -w @openclicky/cli",
    "sandbox": "npm run start -w @openclicky/sandbox",
    "postinstall": "node scripts/hello.mjs",
    "overlay": "npm run start -w @openclicky/desktop",
    "docs:compat": "node scripts/compat-doc.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
